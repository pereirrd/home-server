# Timezone
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
TZ=America/Sao_Paulo

# Immich version (pin with e.g. v2.1.0, or use release / v3)
# https://docs.immich.app/install/docker-compose
IMMICH_VERSION=release

# Host paths
# UPLOAD_LOCATION: library of photos/videos (enough free space)
# DB_DATA_LOCATION: PostgreSQL data — network shares are not supported
# https://docs.immich.app/install/environment-variables
UPLOAD_LOCATION=/home/username/Immich/library
DB_DATA_LOCATION=/home/username/Immich/postgres

# Database
# Use only A-Za-z0-9 for DB_PASSWORD (no special characters or spaces)
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_PASSWORD=your_db_password

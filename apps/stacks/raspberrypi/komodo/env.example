# Tag das imagens komodo-core e komodo-periphery (ex.: latest ou 1.x.x)
COMPOSE_KOMODO_IMAGE_TAG=latest

# Diretório de backups do Core e pasta de Resource Sync montada em /syncs
COMPOSE_KOMODO_BACKUPS_PATH=/home/username/Admin/komodo/backups
COMPOSE_KOMODO_SYNCS_PATH=/home/username/servidor/docker/komodo/syncs

# MongoDB — criado na primeira subida. Não troque depois sem migrar o volume.
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=your_mongo_root_password

# Core
TZ=America/Sao_Paulo
KOMODO_HOST=https://komodo.local.meudominio.me
KOMODO_TITLE=komodo
KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=your_komodo_admin_password
KOMODO_FIRST_SERVER_NAME=raspberrypi
KOMODO_DISABLE_USER_REGISTRATION=true

# Preencha com os segredos gerados na documentação do Komodo. Não versione o .env.
KOMODO_JWT_SECRET=your_jwt_secret
KOMODO_WEBHOOK_SECRET=your_webhook_secret
KOMODO_PERIPHERY_PUBLIC_KEY=
PERIPHERY_CORE_PUBLIC_KEYS=

# Periphery deste host. O diretório dentro do contêiner repete o caminho do host.
PERIPHERY_ROOT_DIRECTORY=/home/username/servidor
PERIPHERY_CORE_ADDRESS=http://core:9120
PERIPHERY_CONNECT_AS=raspberrypi

# Postgres do gateway
POSTGRES_USER=mcpjungle
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=mcpjungle
MCPJUNGLE_DATA_PATH=/home/username/Mcps/mcpjungle/postgres
MCPJUNGLE_HOST_PATH=/home/username/Mcps/mcpjungle/host

# MCPJungle — latest-stdio inclui npx e uvx para servidores STDIO
MCPJUNGLE_IMAGE_TAG=latest-stdio
SERVER_MODE=development
OTEL_ENABLED=false
MCP_SERVER_INIT_REQ_TIMEOUT_SEC=30

# MCP do Komodo. Sem auth: o único cliente é o gateway, na rede Docker.
# Nesse modo o servidor fica somente leitura.
TZ=America/Sao_Paulo
# Imagem publicada pelo servidor MCP do Komodo que você escolher. Não há um nome fixo neste exemplo.
KOMODO_MCP_IMAGE=your_komodo_mcp_image
KOMODO_MCP_IMAGE_TAG=latest
KOMODO_MCP_PORT=8000
KOMODO_MCP_TRANSPORT_MODE=http
MCP_AUTH_ENABLED=false
MCP_ALLOWED_HOSTS=komodo-mcp-server:8000
KOMODO_URL=http://komodo-core:9120
KOMODO_API_KEY=your_komodo_api_key
KOMODO_API_SECRET=your_komodo_api_secret

# MCP do Nginx Proxy Manager (os dois painéis)
NPM_MCP_IMAGE=ghcr.io/b3nw/nginx-proxy-manager-mcp
NPM_MCP_IMAGE_TAG=latest

# Painel deste Pi — nome do container na proxy_network
NPM_RPI_API_URL=http://nginx-proxy-manager:81/api
NPM_RPI_IDENTITY=your_npm_user
NPM_RPI_SECRET=your_npm_password

# Painel do Dell — API pela LAN, não pelo nome Docker
NPM_DELL3050_API_URL=http://10.0.0.x:81/api
NPM_DELL3050_IDENTITY=your_npm_user
NPM_DELL3050_SECRET=your_npm_password

# Timezone / user
TZ=America/Sao_Paulo
PUID=1000
PGID=1000

# Portainer CE (mesmo host — proxy_network)
PORTAINER_URL=http://portainer:9000

# Portainer MCP
PORTAINER_MCP_AUTH_TOKEN=your_portainer_mcp_auth_token
PORTAINER_MCP_TRANSPORT=http
PORTAINER_MCP_HTTP_HOST=0.0.0.0
PORTAINER_MCP_HTTP_PORT=17717
PORTAINER_READ_ONLY=0
PORTAINER_TIMEOUT=120
PORTAINER_MCP_ALLOWED_HOSTS=mcp.local.meudominio.me
PORTAINER_MCP_LOG_LEVEL=INFO
PORTAINER_MCP_LOG_FORMAT=json
PORTAINER_MCP_FORWARDED_ALLOW_IPS=172.16.0.0/12
# 1 = NPM faz SSL termination; HTTP plaintext entre NPM e o MCP
PORTAINER_MCP_DANGEROUSLY_ALLOW_PLAINTEXT_HTTP=1

# Portainer Backup
PORTAINER_BACKUP_TOKEN=your_portainer_api_token
PORTAINER_BACKUP_OVERWRITE=1
PORTAINER_BACKUP_SCHEDULE=0 0 0 * * *
PORTAINER_BACKUP_STACKS=1
PORTAINER_BACKUP_DRYRUN=0
PORTAINER_BACKUP_CONCISE=1
PORTAINER_BACKUP_DIRECTORY=/backup
PORTAINER_BACKUP_FILENAME=portainer-backup.tar.gz
PORTAINER_BACKUP_HOST_PATH=/home/username/Admin/portainer/backup

# Cloudflare Tunnel (túnel deste host — raspberrypi)
CLOUDFLARED_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# Filebrowser
FILEBROWSER_SRV_PATH=/
FILEBROWSER_DATABASE_PATH=/home/username/Admin/filebrowser/database
FILEBROWSER_CONFIG_PATH=/home/username/Admin/filebrowser/config

# Nginx Proxy Manager (entrada *.local + MQTT 1883)
NGINX_PROXY_DATA_PATH=/home/username/Admin/nginx/data
NGINX_PROXY_LETSENCRYPT_PATH=/home/username/Admin/nginx/letsencrypt

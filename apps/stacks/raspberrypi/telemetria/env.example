# Diretório no host com configs (mosquitto, telegraf, grafana)
STACK_DIR=/home/username/Telemetria

# MQTT (senhas também refletidas em mosquitto/config/passwd e acl)
MQTT_GLANCES_PASSWORD=your_mqtt_glances_password
MQTT_TELEGRAF_PASSWORD=your_mqtt_telegraf_password

# InfluxDB 2.x (setup na primeira subida)
INFLUX_USERNAME=admin
INFLUX_PASSWORD=your_influx_password
INFLUX_TOKEN=your_influx_admin_token
INFLUX_ORG=home
INFLUX_BUCKET=glances

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password
GRAFANA_ROOT_URL=https://grafana.local.meudominio.me

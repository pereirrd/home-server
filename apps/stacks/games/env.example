# Romm Database
DB_HOST=romm-db
DB_NAME=romm
DB_USER=romm-user
# Used by both romm (DB_PASSWD) and mariadb (MARIADB_PASSWORD)
DB_PASSWORD=your_db_password
MARIADB_ROOT_PASSWORD=your_mariadb_root_password
MARIADB_DATABASE=romm
MARIADB_USER=romm-user

# Romm Auth (generate with: openssl rand -hex 32)
ROMM_AUTH_SECRET_KEY=your_secret_key

# Metadata Providers
# https://docs.romm.app/latest/Getting-Started/Metadata-Providers/
SCREENSCRAPER_USER=your_screenscraper_username
SCREENSCRAPER_PASSWORD=your_screenscraper_password
RETROACHIEVEMENTS_API_KEY=your_retroachievements_api_key
STEAMGRIDDB_API_KEY=your_steamgriddb_api_key
HASHEOUS_API_ENABLED=true

# Host paths
# https://docs.romm.app/latest/Getting-Started/Folder-Structure/
ROMM_LIBRARY_PATH=/home/username/Games/library
ROMM_ASSETS_PATH=/home/username/Games/assets
ROMM_CONFIG_PATH=/home/username/Games/config

# Port mapping (host:container)
ROMM_PORT=9080

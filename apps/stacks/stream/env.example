# Timezone / user
TZ=America/Sao_Paulo
PUID=1000
PGID=1000

# qBittorrent
WEBUI_PORT=8080
UMASK=002

# Jackett
AUTO_UPDATE=true

# Seerr
SEERR_LOG_LEVEL=debug

# Jellyfin — GIDs do host para /dev/dri (VAAPI / Intel Quick Sync)
# Confira no host: getent group render video
JELLYFIN_RENDER_GID=992
JELLYFIN_VIDEO_GID=44

# Host paths (Dell — configs em home, mídia no HDD)
STREAM_MEDIA_PATH=/media/username/HDD/stream
JELLYFIN_CONFIG_PATH=/home/username/Stream/jellyfin/config
JELLYFIN_CACHE_PATH=/home/username/Stream/jellyfin/cache
SEERR_CONFIG_PATH=/home/username/Stream/jelyserr/config
QBITTORRENT_CONFIG_PATH=/home/username/Stream/qbittorrent/config
JACKETT_CONFIG_PATH=/home/username/Stream/jackett/config
PROWLARR_CONFIG_PATH=/home/username/Stream/prowlarr/config
RADARR_CONFIG_PATH=/home/username/Stream/radarr/config
SONARR_CONFIG_PATH=/home/username/Stream/sonarr/config
BAZARR_CONFIG_PATH=/home/username/Stream/bazarr/config
